              "leftValue": "={{ \n(() => {\n    // 1. Verificamos si va directo al grano (Regex para detectar días u horas)\n    const msg = $('Extraer Datos').item.json.message_received.toLowerCase();\n    const vaDirectoAlGrano = /\\b(hoy|mañana|lunes|martes|mi[eé]rcoles|jueves|viernes|s[aá]bado|\\d{1,2}[:.]?\\d{0,2}\\s*(hs|hrs|horas|am|pm)?)\\b/i.test(msg);\n    \n    // Si va directo al grano, mandamos TRUE para que vaya directo al Agente IA (saltea bienvenida)\n    if (vaDirectoAlGrano) return true;\n\n    // 2. Verificamos la regla de las 48 horas usando la fecha de la sesión guardada\n    const ultimaVez = $node[\"Get row(s) in sheet\"].json[\"UltimaVez\"];\n    if (ultimaVez) {\n        // Luxon viene integrado nativo en n8n\n        const fechaSesion = DateTime.fromISO(ultimaVez);\n        const horasPasadas = $now.diff(fechaSesion, 'hours').hours;\n        \n        // Si pasaron menos de 48 horas, mandamos TRUE (saltea bienvenida)\n        if (horasPasadas < 48) return true;\n    }\n\n    // Si no dijo ningún horario y pasaron más de 48 hs (o es cliente nuevo), FALSE (Manda bienvenida)\n    return false;\n})() \n}}",
