      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst phone = $input.first().json.phone_number;\nconst timeNow = new Date().getTime();\n\n// 5000 milisegundos = 5 segundos de \"escudo\". Podés subirlo si querés.\nconst tiempoBloqueo = 10000; \nlet esSpam = false;\n\nif (staticData[phone] && (timeNow - staticData[phone]) < tiempoBloqueo) {\n    esSpam = true; // Llegó muy rápido, lo marcamos como spam\n} else {\n    staticData[phone] = timeNow; // Es válido, guardamos la hora\n}\n\n// Pasamos todos los datos originales y sumamos nuestra alerta de spam\nreturn {\n  json: {\n    ...$input.first().json,\n    es_spam: esSpam\n  }\n};"
