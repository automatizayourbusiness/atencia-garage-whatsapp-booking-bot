      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json;\n\n// Al usar un webhook normal, n8n mete todo adentro de \"body\"\nconst webhookBody = data.body || data;\n\n// WAHA envía la información principal dentro de 'payload'\nconst payload = webhookBody.payload || webhookBody;\n\n// Evitar procesar mensajes que el bot (o tú mismo) envía (fromMe = true)\nif (!payload || payload.fromMe === true) {\n  return null; \n}\n\n// Extraer el texto del mensaje\nlet message_text = payload.body || '';\nconst msgType = payload.type || '';\n\n// Si es un formato de voz, o si directamente no tiene texto (audio, imagen, sticker), \n// lo marcamos como audio para que el cortafuegos lo ataje más adelante.\nlet is_audio = false;\nif (msgType === 'ptt' || msgType === 'audio' || msgType === 'voice' || payload.hasMedia || !message_text || message_text.trim() === '') {\n    is_audio = true;\n    message_text = ''; // Nos aseguramos de que el texto quede limpio\n}\n\n// 1. Extraer el número base\nlet phoneRaw = payload.from || '';\n\n// 2. Si viene con @lid, buscamos el número real en SenderAlt\nif (phoneRaw.includes('@lid') && payload['_data'] && payload['_data']['Info'] && payload['_data']['Info']['SenderAlt']) {\n    phoneRaw = payload['_data']['Info']['SenderAlt'];\n}\n\n// 3. Limpiar CUALQUIER sufijo usando una expresión regular\nconst phone = phoneRaw.replace(/@c\\.us|@s\\.whatsapp\\.net|@lid/g, '');\n\n// Extraer el nombre del cliente\nlet name = 'Cliente';\nif (payload['_data'] && payload['_data']['notifyName']) {\n  name = payload['_data']['notifyName'];\n} else if (payload['notifyName']) {\n  name = payload['notifyName'];\n}\n\nreturn {\n  json: {\n    message_received: message_text,\n    phone_number: phone,\n    user_name: name,\n    is_audio: is_audio // Viaja directo al cortafuegos\n  }\n};"
      },
